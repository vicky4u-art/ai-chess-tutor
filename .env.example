# --- Server ---
PORT=3001
# SQLite file location (default: ./data/chesstutor.sqlite relative to server/)
DATA_DIR=./data
# Optional single-user access token. If set, all /api/* routes (except /api/health)
# require: Authorization: Bearer <token>. Leave empty for local-only use.
APP_TOKEN=

# --- AI tutor (server-side only; never expose these to the client) ---
# Provider: "openai" | "anthropic" | "compatible" (any OpenAI-compatible endpoint)
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
# Only needed for AI_PROVIDER=compatible (e.g. a local model server)
AI_BASE_URL=
# Max tokens per tutor reply
AI_MAX_TOKENS=600

# --- Client (build-time, prefixed with VITE_) ---
# URL of the server API as seen by the browser. Default in dev: http://localhost:3001
VITE_API_URL=http://localhost:3001
# Must match APP_TOKEN when the server requires it
VITE_APP_TOKEN=
