{
  "dependencies": {
    "@chesstutor/shared": "*",
    "chess.js": "^1.4.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  },
  "main": "dist/index.js",
  "name": "@chesstutor/server",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json && mkdir -p dist/db && cp src/db/schema.sql dist/db/schema.sql",
    "db:migrate": "tsx src/db/migrate.ts",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:types": "tsc -p tsconfig.check.json"
  },
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.5"
  }
}